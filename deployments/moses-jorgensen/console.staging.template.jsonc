{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"moses-operator-console-staging","main":"../../src/console.ts","compatibility_date":"2026-08-10","compatibility_flags":["nodejs_compat"],"workers_dev":true,
  "secrets":{"required":["VAPID_PUBLIC_KEY"]},
  "assets":{"directory":"../../staff-app/dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":true},
  "d1_databases":[{"binding":"DB","database_name":"moses-operator-crm-staging","database_id":"00000000-0000-0000-0000-000000002001","migrations_dir":"../../migrations"}],
  "vars":{
    "BUSINESS_PROFILE":"moses","DEPLOYMENT_KEY":"moses-operator-console-staging","PUBLIC_API_ENABLED":"false","PUBLIC_SITE_ORIGIN":"",
    "CONCURRENT_EVENT_CAPACITY":"1","PRESENCE_TIMEOUT_SECONDS":"120","ENVIRONMENT":"staging","STAFF_AUTH_MODE":"access",
    "STAFF_HOSTNAME":"moses-operator-console-staging.freedomgeneration1111.workers.dev","ACCESS_TEAM_DOMAIN":"https://freedomgeneration1111.cloudflareaccess.com",
    "ACCESS_AUD":"MOSES_STAGING_ACCESS_AUD_REQUIRED","NATIVE_CHAT_BACKEND":"service"
  },
  "services":[{"binding":"CHAT_API","service":"moses-operator-api-staging"}],
  "observability":{"enabled":true,"logs":{"enabled":true,"head_sampling_rate":1}}
}
