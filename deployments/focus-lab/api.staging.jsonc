{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "focus-lab-api-staging",
  "main": "../../src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {"required": ["VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY", "VAPID_SUBJECT"]},
  "d1_databases": [{"binding":"DB","database_name":"focuslab-crm-staging","database_id":"9a7e55cb-7b26-4521-b48d-bd607e1b207c","migrations_dir":"../../migrations"}],
  "kv_namespaces": [{"binding":"AVAILABILITY_CACHE","id":"41bd5932cce34db295fe820d491569a3"}],
  "ratelimits": [
    {"name":"INQUIRY_RATE_LIMITER","namespace_id":"12003","simple":{"limit":10,"period":60}},
    {"name":"CHAT_RATE_LIMITER","namespace_id":"12004","simple":{"limit":30,"period":60}},
    {"name":"AVAILABILITY_RATE_LIMITER","namespace_id":"12007","simple":{"limit":20,"period":60}}
  ],
  "triggers": {"crons": ["*/10 * * * *"]},
  "vars": {
    "BUSINESS_PROFILE":"focus","DEPLOYMENT_KEY":"focus-lab-api-staging","PUBLIC_API_ENABLED":"true",
    "PUBLIC_SITE_ORIGIN":"https://focus-lab-public-staging.freedomgeneration1111.workers.dev",
    "CUSTOMER_CONVERSATION_ORIGIN":"https://focus-lab-public-staging.freedomgeneration1111.workers.dev",
    "CONCURRENT_EVENT_CAPACITY":"1","PRESENCE_TIMEOUT_SECONDS":"120","ENVIRONMENT":"staging","STAFF_AUTH_MODE":"access","STAFF_HOSTNAME":"",
    "TURNSTILE_EXPECTED_HOSTNAMES":"focuslabproductions.com,focus-lab-public-staging.freedomgeneration1111.workers.dev",
    "ACCESS_TEAM_DOMAIN":"https://freedomgeneration1111.cloudflareaccess.com",
    "ACCESS_AUD":"295ea7bd524addc2c13be76f041dc72e23fde3fd4a8c4d1c98ae456b8e160000",
    "VAPID_KEYSET_ID":"focus-staging-existing",
    "BUSINESS_TIMEZONE":"America/Chicago","AVAILABILITY_WINDOW_MONTHS":"6","AVAILABILITY_CACHE_STALE_MINUTES":"30",
    "OPS_NOTIFY_EMAIL":"focuslabproductions@gmail.com","STAFF_CONSOLE_ORIGIN":"https://staff.focuslabproductions.com","CMS_ENABLED":"false"
  },
  "observability":{"enabled":true,"logs":{"enabled":true,"head_sampling_rate":1}},
  "durable_objects":{"bindings":[{"name":"CHAT_ROOMS","class_name":"ChatRoom"},{"name":"CHAT_STAFF_HUB","class_name":"StaffChatHub"}]},
  "exports":{"ChatRoom":{"type":"durable-object","storage":"sqlite"},"StaffChatHub":{"type":"durable-object","storage":"sqlite"}}
}
