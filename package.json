{
  "name": "operator-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "staff:typecheck": "tsc -p staff-app/tsconfig.json --noEmit",
    "lint": "eslint src test business-profiles.mts scripts",
    "staff:lint": "eslint staff-app/src",
    "test:operations": "vitest run --config vitest.config.mts",
    "staff:test": "vitest run --config staff-app/vitest.config.mts",
    "staff:dev": "vite --config staff-app/vite.config.mts",
    "staff:build": "VITE_BUSINESS_PROFILE=focus vite build --config staff-app/vite.config.mts",
    "staff:build:focus": "VITE_BUSINESS_PROFILE=focus vite build --config staff-app/vite.config.mts",
    "staff:build:moses": "VITE_BUSINESS_PROFILE=moses vite build --config staff-app/vite.config.mts",
    "staff:build:focus:staging": "VITE_BUSINESS_PROFILE=focus VITE_APP_STAGE=staging VITE_AUTH_MODE=access vite build --config staff-app/vite.config.mts",
    "staff:build:moses:staging": "VITE_BUSINESS_PROFILE=moses VITE_APP_STAGE=staging VITE_AUTH_MODE=access vite build --config staff-app/vite.config.mts",
    "test:staff:e2e": "playwright test --config staff-app/playwright.config.ts",
    "test:config-isolation": "node --test scripts/deployment-isolation.test.mjs",
    "focus:staging:migrate": "wrangler d1 migrations apply focuslab-crm-staging --remote --config deployments/focus-lab/api.staging.jsonc",
    "focus:staging:deploy:api": "wrangler deploy --config deployments/focus-lab/api.staging.jsonc",
    "focus:staging:deploy:console": "npm run staff:build:focus:staging && wrangler deploy --config deployments/focus-lab/console.staging.jsonc",
    "moses:staging:migrate": "wrangler d1 migrations apply moses-operator-crm-staging --remote --config deployments/moses-jorgensen/api.staging.jsonc",
    "moses:staging:deploy:api": "wrangler deploy --config deployments/moses-jorgensen/api.staging.jsonc",
    "moses:staging:deploy:console": "npm run staff:build:moses:staging && wrangler deploy --config deployments/moses-jorgensen/console.staging.jsonc"
  },
  "dependencies": {
    "jose": "^6.2.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^30.0.1",
    "next": "^15.5.23",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
