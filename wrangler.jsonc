{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "focus-lab-operations",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "staff-app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/v1/*",
      "/health"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focus-lab-operations-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_SITE_ORIGIN": "http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173",
    "CONCURRENT_EVENT_CAPACITY": "1",
    "PRESENCE_TIMEOUT_SECONDS": "120",
    "ENVIRONMENT": "development",
    "STAFF_AUTH_MODE": "development",
    "STAFF_HOSTNAME": "localhost,127.0.0.1"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
